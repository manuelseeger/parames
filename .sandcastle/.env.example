# Claude Code OAuth token — get one by running `claude setup-token` on your host.
CLAUDE_CODE_OAUTH_TOKEN=
# Or use an Anthropic API key instead:
# ANTHROPIC_API_KEY=
# GitHub personal access token used by agents to manage issues and PRs.
GH_TOKEN=
# Optional PR/root base branch. Defaults to the repository default branch.
# SANDCASTLE_BASE_BRANCH=main

# Every Sandcastle phase runs in a Docker Sandboxes microVM. These defaults
# match the local template and the spike-proven castle size.
# SANDCASTLE_SBX_TEMPLATE=parames-sbx:dev
# SANDCASTLE_SBX_CPUS=4
# SANDCASTLE_SBX_MEMORY=8g
# SANDCASTLE_SBX_TIMEOUT_MS=600000
# SANDCASTLE_DEPLOYMENT_ID=local
# SANDCASTLE_INVOCATION_ID=<CI-run-id>
